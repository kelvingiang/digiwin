# [25/11/2026] - Mẫu biến môi trường cho theme DGW (copy sang .env và điền giá trị thật trên Production, KHÔNG commit file .env)

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Digiwin Vietnam"

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lark (Feishu) Notification Webhook
LARK_WEBHOOK_URL=
