# ==============================================================================
# [2026-10-05] - @author: Kelvin - Sample Environment Variables
# Copy file nay thanh .env tai thu muc goc WordPress hoac thu muc Theme de cau hinh
# ==============================================================================

# SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTH=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Digiwin Vietnam"

# [25/11/2026] - Cloudflare Turnstile & Lark Webhook
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/your_webhook_id
