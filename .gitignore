# --- 1. 排除 WordPress 核心文件 ---
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php
/sitemaps/

# --- 2. 排除敏感設定與環境文件 ---
wp-config.php
wp-config-hosting.php
error_log
.htaccess

# --- 3. 排除 wp-content 中的非開發內容 ---
/wp-content/cache/
/wp-content/et-cache/
/wp-content/backups/
#/wp-content/languages/
#/wp-content/upgrade/
#/wp-content/uploads/

# --- 4. 插件與主題管理 ---
/wp-content/themes/*
/wp-content/plugins/*

# 允許 Git 進入 themes 與 plugins 目錄掃描
!/wp-content/themes/
!/wp-content/plugins/

# --- 5. [關鍵] 保留你的開發項目 ---
!/wp-content/themes/dgw/
!/wp-content/themes/dgw/**

# ----------------------------------------------------
# [注意] 如果有需要保留在 plugins 內的自定义插件，請在此解除忽略，例如：
# !/wp-content/plugins/my-custom-plugin/
# !/wp-content/plugins/my-custom-plugin/**
# ----------------------------------------------------

# ====================================================
# [非常重要] 
# 以下的排除規則必須放在保留規則之後，
# 否則會被上面的「保留規則」強制覆蓋，導致 Git 繼續追蹤它們！
# ====================================================

# --- 6. 忽略開發套件與快取 ---
vendor/
.agent/
node_modules/
_database/

# --- 7. 開發工具與系統快取 ---
css/
et-cache/
data/
test-results/
playwright-report/
blob-report/
.cache/
.auth/
google-credentials.json

# --- 8. 排除系統與 IDE 垃圾文件 ---
.DS_Store
.DS_Store?
.vscode/
*.code-workspace